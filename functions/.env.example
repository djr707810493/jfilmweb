# Google Analytics Data API (GA4) property id, e.g. properties/123456789
GA_PROPERTY_ID=

# Google Business Profile reviews via Places API (server-side only)
# Place ID is optional: when omitted, Text Search uses the query below.
GOOGLE_PLACE_ID=
GOOGLE_PLACES_QUERY=J FILM STUDIO Utah wedding photographer
GOOGLE_PLACES_API_KEY=

# Service account with Viewer access on the GA4 property (optional; Cloud
# Functions uses its default service account if credentials are omitted)
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=
